  "meta": {
    "edition": "hi",
    "title": "क्वांटम संवाद",
    "purpose": "One approved Hindi rendering per technical term, covering the vocabulary of all 22 cantos. Enforced by apps/hindi/scripts/glossary-check.mjs on every build. Terminology drift across 25,000 words is invisible to a reader and obvious to a script.",
    "policy": {
      "transliterate": "Established technical terms that working Indian physicists say in English keep their sound in Devanagari: क्यूबिट, डिकोहेरेंस, एंटैंगलमेंट.",
      "translate": "Conceptual and metaphorical language is rendered in Hindi, preferring words already carried by Hindi physics teaching (चिरसम्मत, व्यतिकरण, देहली, जालक) over invented compounds.",
      "latin": "Author names, company and machine names, journal titles, units written as symbols, and mathematical symbols stay in Latin exactly as published. In running prose a famous name is written in Devanagari; inside a note block the citation keeps its published Latin form.",
      "numerals": "Latin digits for years, percentages, quantities and citations. Devanagari digits for canto numbers only.",
      "reserved": "A word listed in reservedSense carries its technical meaning only. Its everyday meaning must be carried by a different word."
    }
  },

  "reservedSense": [
    {
      "word": "कला",
      "reservedFor": "phase (the angle around the equator of the Bloch sphere)",
      "everydaySenseBannedHere": "art, craft, skill",
      "useInstead": ["कौशल", "साधना", "हुनर"],
      "note": "The riskiest single decision in the edition. कला is the term Hindi physics teaching already uses (कलांतर = phase difference) and it carries the moon-phase resonance of चंद्रकला, which makes 'the phase drains away' land natively. The cost is that कला is also the ordinary word for art, and the book says 'the art of' often. Banned in that sense throughout."
    },
    {
      "word": "शोर",
      "reservedFor": "noise",
      "collision": "Peter Shor transliterates to the same string.",
      "rule": "Shor is written शोर only when immediately bound to what he made (शोर एल्गोरिदम, शोर का एल्गोरिदम), with a Latin gloss on first use in a canto. Citations keep Shor. Applies to cantos 10 and 16."
    }
  ],

